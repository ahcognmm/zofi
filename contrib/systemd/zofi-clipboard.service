# Clipboard-history listener for zofi's `-show clipboard` tab.
#
# Install (assumes `zig build` has already put the `zofi` binary on PATH,
# e.g. via `zig build -p ~/.local` or a distro package):
#
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/zofi-clipboard.service ~/.config/systemd/user/
#   systemctl --user enable --now zofi-clipboard.service
#
# History lives in $XDG_CACHE_HOME/zofi/clipboard.db (~/.cache/zofi by
# default), capped at 50MB, oldest entries evicted first -- see
# src/core/clipboard.zig. To change the cap, uncomment the Environment=
# line below (1-4096; also set it where you run `zofi -show clipboard`).

[Unit]
Description=zofi clipboard history daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/zofi --clipboard-daemon
#Environment=ZOFI_CLIPBOARD_MAX_MB=50
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
